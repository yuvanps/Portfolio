---
import { experience } from '../lib/portfolio';
import Section from './Section.astro';
---

{
  experience.length > 0 && (
    <Section id="experience" marker="03 / Work" title="Experience">
      <div class="entry-list">
        {experience.map((job) => (
          <article class="panel entry">
            <div class="entry__head">
              <h3 class="entry__title">
                {job.company}
                {job.role && <span class="entry__role"> · {job.role}</span>}
              </h3>
              {job.period && <p class="entry__period">{job.period}</p>}
            </div>
            {job.summary && <p class="muted">{job.summary}</p>}
            {job.highlights.length > 0 && (
              <ul class="bullets">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {job.tech.length > 0 && (
              <ul class="tags" aria-label="Technologies">
                {job.tech.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )}
            {job.relatedProjects.length > 0 && (
              <p class="entry__related">
                <span class="muted">Related project{job.relatedProjects.length > 1 ? 's' : ''}: </span>
                {job.relatedProjects.map((p, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/projects/${p.slug}/`}>{p.title}</a>
                  </>
                ))}
              </p>
            )}
          </article>
        ))}
      </div>
    </Section>
  )
}
