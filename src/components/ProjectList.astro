---
import type { Project } from '../lib/portfolio';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
  /** Category names for the filter bar; omit to render a plain list. */
  filters?: string[];
  maxHighlights?: number;
  heading?: 'h2' | 'h3';
}

const { projects, filters = [], maxHighlights = 0, heading = 'h3' } = Astro.props;
---

<div data-project-list>
  {
    // Hidden until the script runs: without JavaScript every project is simply listed.
    filters.length > 1 && (
      <>
      <div class="filter" role="group" aria-label="Filter projects by category" hidden data-filter-bar>
        <button class="filter__btn" type="button" data-filter="" aria-pressed="true">
          All
        </button>
        {filters.map((name) => (
          <button class="filter__btn" type="button" data-filter={name} aria-pressed="false">
            {name}
          </button>
        ))}
      </div>
      <p class="filter__status" role="status" data-filter-status hidden />
      </>
    )
  }
  <div class="card-grid">
    {projects.map((project) => <ProjectCard project={project} maxHighlights={maxHighlights} heading={heading} />)}
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-project-list]')) {
    const bar = root.querySelector<HTMLElement>('[data-filter-bar]');
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    if (!bar || !status) continue;

    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-project-card]')];

    const apply = (filter: string) => {
      let shown = 0;
      for (const card of cards) {
        const match = !filter || (card.dataset.categories ?? '').split('|').includes(filter);
        card.hidden = !match;
        if (match) shown += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      const noun = shown === 1 ? 'project' : 'projects';
      status.textContent = filter ? `${shown} ${noun} in ${filter}` : `${shown} ${noun}`;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter ?? ''));
    }
    bar.hidden = false;
    status.hidden = false;
    apply('');
  }
</script>
