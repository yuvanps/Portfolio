---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import Section from '../components/Section.astro';
import ProjectList from '../components/ProjectList.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Leadership from '../components/Leadership.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import { person, projects, featuredProjects } from '../lib/portfolio';

const PREVIEW_LIMIT = 6;
const shown = new Set(featuredProjects.map((p) => p.slug));
const more = projects.filter((p) => !shown.has(p.slug)).slice(0, PREVIEW_LIMIT);
---

<BaseLayout description={person.summary}>
  <Hero />
  <FeaturedProjects />
  {
    more.length > 0 && (
      <Section id="projects" marker="02 / Archive" title="More projects">
        <a class="section__more" slot="more" href="/projects/">
          All {projects.length} projects <span aria-hidden="true">→</span>
        </a>
        <ProjectList projects={more} />
      </Section>
    )
  }
  <Experience />
  <Skills />
  <Leadership />
  <Education />
  <Contact />
</BaseLayout>
